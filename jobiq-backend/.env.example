APP_NAME=JobIQ API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# SQLite (default for local dev, no install needed)
# DATABASE_URL=sqlite:///./jobiq.db

# PostgreSQL (uncomment for production or if you have PostgreSQL installed)
# DATABASE_URL=postgresql+psycopg2://jobiq:jobiq@localhost:5432/jobiq

CORS_ORIGINS=["http://localhost:5173"]

JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
